<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_delivery_period" inherit_id="l10n_din5008.report_invoice_document">
        <xpath expr="//tr[@t-if='o.delivery_date']" position="replace">
            <tr t-if="o.delivery_period_start_date and o.delivery_period_end_date">
                <td>Delivery Period</td>
                <td>
                    <span t-field="o.delivery_period_start_date"/> to
                    <span t-field="o.delivery_period_end_date"/>
                </td>
            </tr>
            <tr t-elif="o.delivery_date">
                <td>Delivery Date</td>
                <td><t t-out="o.delivery_date" t-options="{'widget': 'date'}"/></td>
            </tr>
        </xpath>
    </template>
</odoo>
