<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="snippets" inherit_id="website.snippets" name="Lottie Animation Embed">
        <xpath expr="//snippets[@id='snippet_content']" position="inside">
            <t t-snippet="website_lottie_embed.s_lottie_embed"
               t-thumbnail="/website_lottie_embed/static/src/img/snippets/s_lottie_embed.png">
                <keywords>Lottie, Animation</keywords>
            </t>
        </xpath>
    </template>
</odoo>