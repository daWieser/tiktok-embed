<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="s_lottie_embed" name="Lottie Animation">
        <div class="s_lottie_embed" data-transformable="true"
             data-lottie-embed="https://assets10.lottiefiles.com/packages/lf20_vckswclw.json"
             data-speed="1"
             data-loop="true"
             data-autoplay="true">
            <lottie-player src="" background="transparent" speed="1" loop="true" autoplay="true" width="100%"
                           height="100%"></lottie-player>
        </div>
    </template>

    <template id="s_lottie_embed_options" inherit_id="website.snippet_options">
        <xpath expr="." position="inside">
            <div data-js="LottieEmbed" data-selector=".s_lottie_embed" data-drop-in="div">
                <we-row string="Lottie File">
                    <we-button class="o_we_large" data-set-lottie-upload="" data-no-preview="true">Upload Lottie JSON</we-button>
                </we-row>
                <we-row string="URL">
                    <we-input class="o_we_large"
                              data-set-lottie-embed=""
                              placeholder="Enter Lottie JSON URL"
                              data-no-preview="true"/>
                </we-row>
                <we-row string="Speed">
                    <we-input data-set-speed=""
                              data-no-preview="true"/>
                </we-row>
                <we-checkbox string="Loop"
                             data-set-loop="true"
                             data-no-preview="true"/>
                <we-checkbox string="Autoplay"
                             data-set-autoplay="true"
                             data-no-preview="true"/>
                <we-row string="Transform">
                    <we-button class="fa fa-fw fa-object-ungroup" data-transform="true" data-no-preview="true"
                               title="Transform the Lottie animation"/>
                    <we-button class="ms-0 border-start-0" data-reset-transform="" data-no-preview="true"
                               title="Reset transformation">
                        Reset
                    </we-button>
                </we-row>
            </div>
        </xpath>
    </template>

    <record id="website_lottie_embed.s_lottie_embed_000_js" model="ir.asset">
        <field name="name">Lottie Embed 000 JS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">website_lottie_embed/static/src/snippets/s_lottie_embed/000.js</field>
    </record>

    <record id="website_lottie_embed.s_lottie_embed_000_scss" model="ir.asset">
        <field name="name">Lottie Embed 000 SCSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">website_lottie_embed/static/src/snippets/s_lottie_embed/000.scss</field>
    </record>
</odoo>