<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="website_lottie_embed.LottieEmbedOption">
        <BuilderRow label.translate="Lottie File">
            <BuilderButton action="'lottieUpload'" preview="false" type="'primary'">
                Upload Lottie JSON
            </BuilderButton>
        </BuilderRow>
        <BuilderRow label.translate="Lottie URL">
            <BuilderTextInput action="'lottieUrl'" placeholder.translate="Enter Lottie JSON URL"/>
        </BuilderRow>
        <BuilderRow label.translate="Speed">
            <BuilderNumberInput action="'lottieSpeed'" default="1" step="0.1" min="0.1" max="10"/>
        </BuilderRow>
        <BuilderRow label.translate="Loop">
            <BuilderCheckbox action="'lottieLoop'"/>
        </BuilderRow>
        <BuilderRow label.translate="Autoplay">
            <BuilderCheckbox action="'lottieAutoplay'"/>
        </BuilderRow>
    </t>
</templates>
