        <field name="name">rrr</field>
        <field name="description">23. Aufloesung von Gewinnruecklagen</field>
        <field name="expression">-balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_RRR').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">230</field>
    </record>

    <record id="mis_kpi_at_allocation_retained_earnings" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">arr</field>
        <field name="description">24. Zuweisung zu Gewinnruecklagen</field>
        <field name="expression">balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_ARR').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">240</field>
    </record>

    <record id="mis_kpi_at_profit_loss_carried_forward" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">rl</field>
        <field name="description">25. Gewinnvortrag/Verlustvortrag aus dem Vorjahr (+/-)</field>
        <field name="expression">-bale[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_PAIV').id)] - bale[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_RL').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">250</field>
    </record>

    <record id="mis_kpi_at_balance_sheet_profit_loss" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">bilanzgewinn_verlust</field>
        <field name="description">Bilanzgewinn/Bilanzverlust</field>
        <field name="expression">pl + rcr + rrr - arr + rl</field>
        <field name="style_id" ref="mis_template_financial_report.style_header" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">260</field>
    </record>
</odoo>
