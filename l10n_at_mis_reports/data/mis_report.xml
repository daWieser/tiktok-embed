    <record id="mis_kpi_at_result_after_taxes" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebtat</field>
        <field name="description">19. Ergebnis nach Steuern</field>
        <field name="expression">ebt - tax</field>
        <field name="style_id" ref="mis_template_financial_report.style_header" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
