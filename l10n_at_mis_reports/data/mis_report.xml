<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mis_report_at_profit_loss" model="mis.report">
        <field name="name">AT Gewinn- und Verlustrechnung (§ 231 UGB GKV)</field>
        <field name="style_id" ref="mis_template_financial_report.style_default" />
    </record>

    <record id="mis_kpi_at_sales_revenue" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit1</field>
        <field name="description">1. Umsatzerlöse</field>
        <field name="expression">-balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_EBIT1').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">10</field>
    </record>

    <record id="mis_kpi_at_inventory_change" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit2</field>
        <field name="description">2. Veraenderung des Bestands an fertigen und unfertigen Erzeugnissen sowie an noch nicht abrechenbaren Leistungen (+/-)</field>
        <field name="expression">-balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_EBIT2').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">20</field>
    </record>

    <record id="mis_kpi_at_capitalized_own_work" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit3</field>
        <field name="description">3. andere aktivierte Eigenleistungen</field>
        <field name="expression">-balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_EBIT3').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">30</field>
    </record>

    <record id="mis_kpi_at_other_operating_income" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit4</field>
        <field name="description">4. sonstige betriebliche Ertraege</field>
        <field name="expression">ebit4i + ebit4ii + ebit4iii</field>
        <field name="style_id" ref="mis_template_financial_report.style_header" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">40</field>
    </record>

    <record id="mis_kpi_at_other_operating_income_i" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit4i</field>
        <field name="description">4.a Ertraege aus dem Abgang vom und der Zuschreibung zum Anlagevermoegen mit Ausnahme der Finanzanlagen</field>
        <field name="expression">-balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_EBIT4I').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent" />
        <field name="style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">41</field>
    </record>

    <record id="mis_kpi_at_other_operating_income_ii" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit4ii</field>
        <field name="description">4.b Ertraege aus der Aufloesung von Rueckstellungen</field>
        <field name="expression">-balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_EBIT4II').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent" />
        <field name="style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">42</field>
    </record>

    <record id="mis_kpi_at_other_operating_income_iii" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit4iii</field>
        <field name="description">4.c uebrige Ertraege</field>
        <field name="expression">-balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_EBIT4III').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent" />
        <field name="style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">43</field>
    </record>

    <record id="mis_kpi_at_material_services" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit5</field>
        <field name="description">5. Aufwendungen fuer Material und sonstige bezogene Herstellungsleistungen</field>
        <field name="expression">ebit5i + ebit5ii</field>
        <field name="style_id" ref="mis_template_financial_report.style_header" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">50</field>
    </record>

    <record id="mis_kpi_at_material_services_i" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit5i</field>
        <field name="description">5.a Materialaufwand</field>
        <field name="expression">balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_EBIT5I').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent" />
        <field name="style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">51</field>
    </record>

    <record id="mis_kpi_at_material_services_ii" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit5ii</field>
        <field name="description">5.b Aufwendungen fuer bezogene Leistungen</field>
        <field name="expression">balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_EBIT5II').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent" />
        <field name="style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">52</field>
    </record>

    <record id="mis_kpi_at_personnel" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit6</field>
        <field name="description">6. Personalaufwand</field>
        <field name="expression">ebit6i + ebit6ii</field>
        <field name="style_id" ref="mis_template_financial_report.style_header" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">60</field>
    </record>

    <record id="mis_kpi_at_personnel_i" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit6i</field>
        <field name="description">6.a Loehne und Gehaelter</field>
        <field name="expression">balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_EBIT6I').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent" />
        <field name="style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">61</field>
    </record>

    <record id="mis_kpi_at_personnel_ii" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit6ii</field>
        <field name="description">6.b soziale Aufwendungen</field>
        <field name="expression">balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_EBIT6II').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent" />
        <field name="style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">62</field>
    </record>

    <record id="mis_kpi_at_depreciation" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit7</field>
        <field name="description">7. Abschreibungen</field>
        <field name="expression">ebit7i + ebit7ii</field>
        <field name="style_id" ref="mis_template_financial_report.style_header" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">70</field>
    </record>

    <record id="mis_kpi_at_depreciation_i" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit7i</field>
        <field name="description">7.a auf immaterielle Gegenstaende des Anlagevermoegens und Sachanlagen</field>
        <field name="expression">balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_EBIT7I').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent" />
        <field name="style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">71</field>
    </record>

    <record id="mis_kpi_at_depreciation_ii" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit7ii</field>
        <field name="description">7.b auf Gegenstaende des Umlaufvermoegens, soweit diese die im Unternehmen ueblichen Abschreibungen ueberschreiten</field>
        <field name="expression">balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_EBIT7II').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details_double_indent" />
        <field name="style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">72</field>
    </record>

    <record id="mis_kpi_at_other_operating_expenses" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit8</field>
        <field name="description">8. sonstige betriebliche Aufwendungen</field>
        <field name="expression">balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_EBIT8').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">80</field>
    </record>

    <record id="mis_kpi_at_operating_result" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebit</field>
        <field name="description">9. Betriebsergebnis (Zwischensumme aus Z 1 bis 8)</field>
        <field name="expression">ebit1 + ebit2 + ebit3 + ebit4 - ebit5 - ebit6 - ebit7 - ebit8</field>
        <field name="style_id" ref="mis_template_financial_report.style_header" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">90</field>
    </record>

    <record id="mis_kpi_at_financial_income_participations" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">fin10</field>
        <field name="description">10. Ertraege aus Beteiligungen</field>
        <field name="expression">-balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_FIN10').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">100</field>
    </record>

    <record id="mis_kpi_at_financial_income_securities_loans" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">fin11</field>
        <field name="description">11. Ertraege aus anderen Wertpapieren und Ausleihungen des Finanzanlagevermoegens</field>
        <field name="expression">-balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_FIN11').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">110</field>
    </record>

    <record id="mis_kpi_at_financial_interest_income" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">fin12</field>
        <field name="description">12. sonstige Zinsen und aehnliche Ertraege</field>
        <field name="expression">-balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_FIN12').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">120</field>
    </record>

    <record id="mis_kpi_at_financial_disposal_income" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">fin13</field>
        <field name="description">13. Ertraege aus dem Abgang von und der Zuschreibung zu Finanzanlagen und Wertpapieren des Umlaufvermoegens</field>
        <field name="expression">-balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_FIN13').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">130</field>
    </record>

    <record id="mis_kpi_at_financial_asset_expenses" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">fin14</field>
        <field name="description">14. Aufwendungen aus Finanzanlagen und aus Wertpapieren des Umlaufvermoegens</field>
        <field name="expression">balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_FIN14').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">140</field>
    </record>

    <record id="mis_kpi_at_financial_interest_expenses" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">fin15</field>
        <field name="description">15. Zinsen und aehnliche Aufwendungen, davon betreffend verbundene Unternehmen</field>
        <field name="expression">balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_FIN15').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">150</field>
    </record>

    <record id="mis_kpi_at_financial_result" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">fin</field>
        <field name="description">16. Finanzergebnis (Zwischensumme aus Z 10 bis 15)</field>
        <field name="expression">fin10 + fin11 + fin12 + fin13 - fin14 - fin15</field>
        <field name="style_id" ref="mis_template_financial_report.style_header" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">160</field>
    </record>

    <record id="mis_kpi_at_result_before_taxes" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_at_profit_loss" />
        <field name="name">ebt</field>
        <field name="description">17. Ergebnis vor Steuern (Zwischensumme aus Z 9 und Z 16)</field>
        <field name="expression">ebit + fin</field>
        <field name="style_id" ref="mis_template_financial_report.style_header" />
        <field name="type">num</field>
        <field name="compare_method">diff</field>
        <field name="accumulation_method">sum</field>
        <field name="sequence">170</field>
    </record>

    <record id="mis_kpi_at_income_taxes" model="mis.report.kpi">
