        <field name="description">20. sonstige Steuern, soweit nicht unter den Posten 1 bis 19 enthalten</field>
        <field name="expression">balp[('tag_ids', '=', ref('l10n_at.account_tag_l10n_at_MTAX').id)]</field>
        <field name="auto_expand_accounts">True</field>
        <field name="auto_expand_accounts_style_id" ref="mis_template_financial_report.style_details" />
