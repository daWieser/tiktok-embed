<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="send_vendor_bill_wizard_form_view" model="ir.ui.view">
            <field name="name">send.vendor.bill.wizard.form</field>
            <field name="model">send.vendor.bill.wizard</field>
            <field name="arch" type="xml">
                <form string="Send Bill">
                    <group>
                        <field name="bill_id" invisible="1"/>
                        <field name="partner_id"/>
                        <field name="convert_to_pdf"/>
                    </group>
                    <footer>
                        <button name="action_send_email" string="Send" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>