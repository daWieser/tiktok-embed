<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_vendor_bill" model="mail.template">
            <field name="name">Vendor Bill - Send to Contact</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Vendor Bill {{ object.name }}</field>
            <field name="body_html"><![CDATA[
<p>
    Please find attached the vendor bill.<br/><br/>
    Best regards
</p>
            ]]></field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>