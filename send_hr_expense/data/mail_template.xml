<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_expense_report" model="mail.template">
            <field name="name">Expense Report - Send to Contact</field>
            <field name="model_id" ref="hr_expense.model_hr_expense"/>
            <field name="subject">Expense Report {{ object.name }}</field>
            <field name="body_html"><![CDATA[
<p>
    Please find attached the expense report.<br/><br/>
    Best regards
</p>
            ]]></field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
