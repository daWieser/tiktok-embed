<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_view_wareneingangsbuch" model="ir.ui.view">
        <field name="name">product.category.form.wareneingangsbuch</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <group string="Wareneingangsbuch">
                    <field name="l10n_at_wareneingangsbuch_include"/>
                    <field
                        name="l10n_at_wareneingangsbuch_label"
                        placeholder="z.B. KFZ-Ersatzteile"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
