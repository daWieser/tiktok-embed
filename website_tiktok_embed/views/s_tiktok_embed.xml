<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_tiktok_embed" name="TikTok video embed">
    <div class="s_tiktok_embed o_snippet_drop_in_only" data-tiktok-embed="https://www.tiktok.com/@odoo/video/7552187645137407252">
        <div class="o_tiktok_container">
            <!-- Configuration UI: Visible ONLY in Edit Mode -->
            <!-- We use an anchor tag because Odoo natively provides a Link Editor for it -->
            <div class="text-center css_non_editable_mode_hidden mb-3 p-3 border border-info bg-light">
                <i class="fa fa-tiktok fa-2x mb-2"/>
                <h5>TikTok Setup</h5>
                <p class="text-muted small">Click the button below to set the TikTok Video URL.</p>
                <a href="https://www.tiktok.com/@odoo/video/7552187645137407252" 
                   class="btn btn-primary o_tiktok_url_config">
                   <i class="fa fa-link"/> Set Video URL
                </a>
            </div>
            
            <!-- The iframe will be added here by the public widget. -->
        </div>
    </div>
</template>

</odoo>
